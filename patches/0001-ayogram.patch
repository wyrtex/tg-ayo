+// Ayo: user-selected app font (Ayo settings → Оформление). Read once; changes apply after restart.
+private let ayoAppFontName: String = UserDefaults.standard.string(forKey: "ayo.appFont") ?? ""
+
+func ayoCustomFont(size: CGFloat, weight: UIFont.Weight, italic: Bool = false, monospacedNumbers: Bool = false) -> UIFont? {
+    if ayoAppFontName.isEmpty {
+        return nil
+    }
+    var descriptor: UIFontDescriptor
+    switch ayoAppFontName {
+    case "rounded", "serif", "mono":
+        let base = UIFont.systemFont(ofSize: size, weight: weight).fontDescriptor
+        let design: UIFontDescriptor.SystemDesign
+        if ayoAppFontName == "rounded" {
+            design = .rounded
+        } else if ayoAppFontName == "serif" {
+            design = .serif
+        } else {
+            design = .monospaced
+        }
+        guard let designed = base.withDesign(design) else {
+            return nil
+        }
+        descriptor = designed
+    default:
+        descriptor = UIFontDescriptor(fontAttributes: [
+            .family: ayoAppFontName,
+            .traits: [UIFontDescriptor.TraitKey.weight: weight]
+        ])
+    }
+    if italic, let italicDescriptor = descriptor.withSymbolicTraits(descriptor.symbolicTraits.union(.traitItalic)) {
+        descriptor = italicDescriptor
+    }
+    if monospacedNumbers {
+        descriptor = descriptor.addingAttributes([
+            UIFontDescriptor.AttributeName.featureSettings: [
+                [UIFontDescriptor.FeatureKey.featureIdentifier: kNumberSpacingType,
+                 UIFontDescriptor.FeatureKey.typeIdentifier: kMonospacedNumbersSelector]
+            ]
+        ])
+    }
+    let font = UIFont(descriptor: descriptor, size: size)
+    if font.familyName.isEmpty {
+        return nil
+    }
+    return font
+}
