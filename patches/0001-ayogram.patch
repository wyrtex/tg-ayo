+
+private final class AyoArguments {
+    let toggle: (String, Bool) -> Void
+    let select: (String) -> Void
+    init(toggle: @escaping (String, Bool) -> Void, select: @escaping (String) -> Void) {
+        self.toggle = toggle
+        self.select = select
+    }
+}
+
+private enum AyoRow {
+    case header(String)
+    case toggle(key: String, title: String, value: Bool)
+    case option(key: String, title: String, checked: Bool)
+    case disclosure(key: String, title: String, label: String, icon: UIImage?)
+    case action(key: String, title: String, destructive: Bool)
+    case footer(String)
+}
+
+private struct AyoSection {
+    let rows: [AyoRow]
+}
+
+private enum AyoEntry: ItemListNodeEntry {
+    case header(id: Int32, section: Int32, text: String)
+    case toggle(id: Int32, section: Int32, key: String, title: String, value: Bool)
+    case option(id: Int32, section: Int32, key: String, title: String, checked: Bool)
+    case disclosure(id: Int32, section: Int32, key: String, title: String, label: String, icon: UIImage?)
+    case action(id: Int32, section: Int32, key: String, title: String, destructive: Bool)
+    case footer(id: Int32, section: Int32, text: String)
+
+    var section: ItemListSectionId {
+        switch self {
+        case let .header(_, section, _), let .toggle(_, section, _, _, _), let .option(_, section, _, _, _), let .disclosure(_, section, _, _, _, _), let .action(_, section, _, _, _), let .footer(_, section, _):
+            return section
+        }
+    }
+
+    var stableId: Int32 {
+        switch self {
+        case let .header(id, _, _), let .toggle(id, _, _, _, _), let .option(id, _, _, _, _), let .disclosure(id, _, _, _, _, _), let .action(id, _, _, _, _), let .footer(id, _, _):
+            return id
+        }
+    }
+
+    static func ==(lhs: AyoEntry, rhs: AyoEntry) -> Bool {
+        switch (lhs, rhs) {
+        case let (.header(lId, lS, lT), .header(rId, rS, rT)):
+            return lId == rId && lS == rS && lT == rT
+        case let (.toggle(lId, lS, lK, lT, lV), .toggle(rId, rS, rK, rT, rV)):
+            return lId == rId && lS == rS && lK == rK && lT == rT && lV == rV
+        case let (.option(lId, lS, lK, lT, lV), .option(rId, rS, rK, rT, rV)):
+            return lId == rId && lS == rS && lK == rK && lT == rT && lV == rV
+        case let (.disclosure(lId, lS, lK, lT, lL, _), .disclosure(rId, rS, rK, rT, rL, _)):
+            return lId == rId && lS == rS && lK == rK && lT == rT && lL == rL
+        case let (.action(lId, lS, lK, lT, lD), .action(rId, rS, rK, rT, rD)):
+            return lId == rId && lS == rS && lK == rK && lT == rT && lD == rD
+        case let (.footer(lId, lS, lT), .footer(rId, rS, rT)):
+            return lId == rId && lS == rS && lT == rT
+        default:
+            return false
+        }
+    }
+
+    static func <(lhs: AyoEntry, rhs: AyoEntry) -> Bool {
+        return lhs.stableId < rhs.stableId
+    }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! AyoArguments
+        switch self {
+        case let .header(_, section, text):
+            return ItemListSectionHeaderItem(presentationData: presentationData, text: text, sectionId: section)
+        case let .toggle(_, section, key, title, value):
+            return ItemListSwitchItem(presentationData: presentationData, systemStyle: .glass, title: title, value: value, sectionId: section, style: .blocks, updated: { value in
+                arguments.toggle(key, value)
+            })
+        case let .option(_, section, key, title, checked):
+            return ItemListCheckboxItem(presentationData: presentationData, systemStyle: .glass, title: title, style: .left, checked: checked, zeroSeparatorInsets: false, sectionId: section, action: {
+                arguments.select(key)
+            })
+        case let .disclosure(_, section, key, title, label, icon):
+            return ItemListDisclosureItem(presentationData: presentationData, systemStyle: .glass, icon: icon, title: title, label: label, labelStyle: .text, sectionId: section, style: .blocks, disclosureStyle: .arrow, action: {
+                arguments.select(key)
+            })
+        case let .action(_, section, key, title, destructive):
+            return ItemListActionItem(presentationData: presentationData, systemStyle: .glass, title: title, kind: destructive ? .destructive : .generic, alignment: .natural, sectionId: section, style: .blocks, action: {
+                arguments.select(key)
+            })
+        case let .footer(_, section, text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: section)
+        }
+    }
+}
+
+private func ayoEntries(_ sections: [AyoSection]) -> [AyoEntry] {
+    var entries: [AyoEntry] = []
+    var id: Int32 = 0
+    for (sectionIndex, section) in sections.enumerated() {
+        let sectionId = Int32(sectionIndex)
+        for row in section.rows {
+            switch row {
+            case let .header(text):
+                entries.append(.header(id: id, section: sectionId, text: text))
+            case let .toggle(key, title, value):
+                entries.append(.toggle(id: id, section: sectionId, key: key, title: title, value: value))
+            case let .option(key, title, checked):
+                entries.append(.option(id: id, section: sectionId, key: key, title: title, checked: checked))
+            case let .disclosure(key, title, label, icon):
+                entries.append(.disclosure(id: id, section: sectionId, key: key, title: title, label: label, icon: icon))
+            case let .action(key, title, destructive):
+                entries.append(.action(id: id, section: sectionId, key: key, title: title, destructive: destructive))
+            case let .footer(text):
+                entries.append(.footer(id: id, section: sectionId, text: text))
+            }
+            id += 1
+        }
+    }
+    return entries
+}
+
+private func ayoListController(context: AccountContext, title: String, sectionsBuilder: @escaping () -> [AyoSection], toggle: @escaping (String, Bool) -> Void, select: @escaping (String, AyoArguments) -> Void) -> ViewController {
+    let refresh = ValuePromise<Int>(0, ignoreRepeated: false)
+    var counter = 0
+    func reload() {
+        counter += 1
+        refresh.set(counter)
+    }
+
+    var argumentsRef: AyoArguments?
+    let arguments = AyoArguments(toggle: { key, value in
+        toggle(key, value)
+        reload()
+    }, select: { key in
+        if let argumentsRef {
+            select(key, argumentsRef)
+        }
+    })
+    argumentsRef = arguments
+
+    let signal = combineLatest(queue: .mainQueue(), context.sharedContext.presentationData, refresh.get())
+    |> map { presentationData, _ -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        var presentationData = presentationData
+        presentationData = presentationData.withUpdated(theme: presentationData.theme.withModalBlocksBackground())
+        let controllerState = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text(title), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let listState = ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: ayoEntries(sectionsBuilder()), style: .blocks, animateChanges: false)
+        return (controllerState, (listState, arguments))
+    }
+
+    return ItemListController(context: context, state: signal)
+}
+
+// MARK: - Hub
