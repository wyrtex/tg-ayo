index 000000000..764a24cd4
--- /dev/null
+++ b/submodules/SettingsUI/Sources/AyoAppearanceController.swift
@@ -0,0 +1,344 @@
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import TelegramUIPreferences
+import ItemListUI
+import PresentationDataUtils
+import AccountContext
+
+private final class AyoAppearanceArguments {
+    let context: AccountContext
+    let select: (String) -> Void
+    init(context: AccountContext, select: @escaping (String) -> Void) {
+        self.context = context
+        self.select = select
+    }
+}
+
+private enum AyoAppearanceEntry: ItemListNodeEntry {
+    case preview(id: Int32, section: Int32)
+    case header(id: Int32, section: Int32, text: String)
+    case option(id: Int32, section: Int32, key: String, title: String, checked: Bool)
+    case fontOption(id: Int32, section: Int32, key: String, fontName: String, title: String, checked: Bool)
+    case color(id: Int32, section: Int32, key: String, title: String, color: UInt32?)
+    case action(id: Int32, section: Int32, key: String, title: String, destructive: Bool)
+    case footer(id: Int32, section: Int32, text: String)
+
+    var section: ItemListSectionId {
+        switch self {
+        case let .preview(_, section), let .header(_, section, _), let .option(_, section, _, _, _), let .fontOption(_, section, _, _, _, _), let .color(_, section, _, _, _), let .action(_, section, _, _, _), let .footer(_, section, _):
+            return section
+        }
+    }
+
+    var stableId: Int32 {
+        switch self {
+        case let .preview(id, _), let .header(id, _, _), let .option(id, _, _, _, _), let .fontOption(id, _, _, _, _, _), let .color(id, _, _, _, _), let .action(id, _, _, _, _), let .footer(id, _, _):
+            return id
+        }
+    }
+
+    static func ==(lhs: AyoAppearanceEntry, rhs: AyoAppearanceEntry) -> Bool {
+        switch (lhs, rhs) {
+        case let (.preview(lId, lSection), .preview(rId, rSection)):
+            return lId == rId && lSection == rSection
+        case let (.header(lId, lSection, lText), .header(rId, rSection, rText)):
+            return lId == rId && lSection == rSection && lText == rText
+        case let (.option(lId, lSection, lKey, lTitle, lChecked), .option(rId, rSection, rKey, rTitle, rChecked)):
+            return lId == rId && lSection == rSection && lKey == rKey && lTitle == rTitle && lChecked == rChecked
+        case let (.fontOption(lId, lSection, lKey, lFont, lTitle, lChecked), .fontOption(rId, rSection, rKey, rFont, rTitle, rChecked)):
+            return lId == rId && lSection == rSection && lKey == rKey && lFont == rFont && lTitle == rTitle && lChecked == rChecked
