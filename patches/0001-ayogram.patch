@@ -0,0 +1,169 @@
+import Foundation
+
+/// AyuGram-style local settings. Stored in UserDefaults so they can be read
+/// synchronously from any thread (network layer, UI).
+public enum AyuSettings {
+    private static let defaults = UserDefaults.standard
+
+    private static func readFlag(_ key: String, _ def: Bool = false) -> Bool {
+        if defaults.object(forKey: key) == nil { return def }
+        return defaults.bool(forKey: key)
+    }
+    private static func writeFlag(_ key: String, _ value: Bool) {
+        defaults.set(value, forKey: key)
+    }
+
+    private static func readInt(_ key: String, _ def: Int = 0) -> Int {
+        if defaults.object(forKey: key) == nil { return def }
+        return defaults.integer(forKey: key)
+    }
+    private static func writeInt(_ key: String, _ value: Int) {
+        defaults.set(value, forKey: key)
+    }
+
+    /// Automatic media cache cleanup: 0 = off, -1 = on every launch, otherwise interval in seconds.
+    public static var autoCacheCleanInterval: Int {
+        get { return readInt("ayo.autoCacheCleanInterval") }
+        set { writeInt("ayo.autoCacheCleanInterval", newValue) }
+    }
+
+    private static func readColors(_ key: String) -> [UInt32] {
+        guard let values = defaults.array(forKey: key) as? [NSNumber] else { return [] }
+        return values.map { $0.uint32Value }
+    }
+    private static func writeColors(_ key: String, _ value: [UInt32]) {
+        if value.isEmpty {
+            defaults.removeObject(forKey: key)
+        } else {
+            defaults.set(value.map { NSNumber(value: $0) }, forKey: key)
+        }
+    }
+
+    // Appearance (applied when the theme is rebuilt / after restart)
+    /// "" = system, "rounded", "serif", "mono" or a font family name. Read directly by Display/Font.swift.
+    public static var appFont: String {
+        get { return defaults.string(forKey: "ayo.appFont") ?? "" }
+        set { defaults.set(newValue, forKey: "ayo.appFont") }
+    }
+    /// 0 = default, 1 = no tail, 2 = equal corners, 3 = rectangular
+    public static var bubbleShape: Int {
+        get { return readInt("ayo.bubbleShape") }
+        set { writeInt("ayo.bubbleShape", newValue) }
+    }
+    /// 0xRRGGBB colors, 1–4 entries make a gradient; empty = theme default
+    public static var outgoingBubbleColors: [UInt32] {
+        get { return readColors("ayo.outgoingBubbleColors") }
+        set { writeColors("ayo.outgoingBubbleColors", newValue) }
+    }
+    public static var incomingBubbleColors: [UInt32] {
+        get { return readColors("ayo.incomingBubbleColors") }
+        set { writeColors("ayo.incomingBubbleColors", newValue) }
+    }
+    /// 0 = automatic
+    public static var outgoingTextColor: UInt32 {
+        get { return UInt32(truncatingIfNeeded: readInt("ayo.outgoingTextColor")) }
+        set { writeInt("ayo.outgoingTextColor", Int(newValue)) }
+    }
+    public static var incomingTextColor: UInt32 {
+        get { return UInt32(truncatingIfNeeded: readInt("ayo.incomingTextColor")) }
+        set { writeInt("ayo.incomingTextColor", Int(newValue)) }
+    }
+
+    // Ghost mode
+    public static var dontReadMessages: Bool {
+        get { return readFlag("ayo.dontRead") }
+        set { writeFlag("ayo.dontRead", newValue) }
+    }
+    public static var dontSendTyping: Bool {
+        get { return readFlag("ayo.dontTyping") }
+        set { writeFlag("ayo.dontTyping", newValue) }
+    }
+    public static var dontSendOnline: Bool {
+        get { return readFlag("ayo.dontOnline") }
+        set { writeFlag("ayo.dontOnline", newValue) }
+    }
+    // Restrictions
+    public static var bypassCopyProtection: Bool {
+        get { return readFlag("ayo.bypassCopyProtection", true) }
+        set { writeFlag("ayo.bypassCopyProtection", newValue) }
+    }
