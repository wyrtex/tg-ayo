+        case "screenshotNotify": AyuSettings.dontNotifyScreenshots = value
+        case "removeAllLimits":
+            AyuSettings.removeAllLimits = value
+            AyuSettings.unlimitedPins = value
+        default: break
+        }
+    }, select: { _, _ in })
+}
