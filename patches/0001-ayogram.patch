+/// Ayo: resolves a font option key (as used in the appearance screen) to a concrete UIFont.
+func ayoResolveFont(_ name: String, size: CGFloat) -> UIFont {
+    switch name {
+    case "":
+        return Font.regular(size)
+    case "rounded":
+        if #available(iOS 13.0, *), let descriptor = UIFont.systemFont(ofSize: size).fontDescriptor.withDesign(.rounded) {
+            return UIFont(descriptor: descriptor, size: size)
+        }
+        return Font.regular(size)
+    case "serif":
+        if #available(iOS 13.0, *), let descriptor = UIFont.systemFont(ofSize: size).fontDescriptor.withDesign(.serif) {
+            return UIFont(descriptor: descriptor, size: size)
+        }
+        return Font.regular(size)
+    case "mono":
+        return UIFont.monospacedSystemFont(ofSize: size, weight: .regular)
+    default:
+        return UIFont(name: name, size: size) ?? Font.regular(size)
+    }
+}
