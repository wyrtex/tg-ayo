diff --git a/submodules/TelegramCallsUI/Sources/AyoCallLiveActivityManager.swift b/submodules/TelegramCallsUI/Sources/AyoCallLiveActivityManager.swift
new file mode 100644
index 000000000..3b6823052
--- /dev/null
+++ b/submodules/TelegramCallsUI/Sources/AyoCallLiveActivityManager.swift
@@ -0,0 +1,131 @@
+import Foundation
+import SwiftSignalKit
+import TelegramCore
+import AccountContext
+import TelegramAudio
+import AyoCallActivity
+#if canImport(ActivityKit)
+import ActivityKit
+#endif
+
+/// Ayo: mirrors the current 1-on-1 call into a Live Activity (Dynamic Island / lock screen)
+/// and performs the actions of its buttons.
+final class AyoCallLiveActivityManager {
+    private weak var call: PresentationCallImpl?
+    private var stateDisposable: Disposable?
+    private var activity: Any?
+    private var isMuted = false
+    private var isSpeaker = false
+    private var isVideo = false
+
+    init() {
+    }
+
+    deinit {
+        self.stateDisposable?.dispose()
+    }
+
+    func setCall(_ call: PresentationCallImpl?) {
+        if self.call === call {
+            return
+        }
+        self.stateDisposable?.dispose()
+        self.stateDisposable = nil
+        self.endActivity()
+        self.call = call
+
+        guard let call, AyuSettings.callLiveActivity else {
+            return
+        }
+
+        AyoCallActionHandler.handler = { [weak self] action in
+            self?.perform(action)
+        }
+
+        let peerName = call.peer?.compactDisplayTitle ?? ""
+        self.stateDisposable = (combineLatest(queue: .mainQueue(), call.state, call.isMuted, call.audioOutputState)
+        |> deliverOnMainQueue).startStrict(next: { [weak self] state, isMuted, audioOutputState in
+            self?.update(peerName: peerName, state: state, isMuted: isMuted, audioOutput: audioOutputState.1)
+        })
+    }
+
+    private func update(peerName: String, state: PresentationCallState, isMuted: Bool, audioOutput: AudioSessionOutput?) {
+        self.isMuted = isMuted
+        self.isSpeaker = audioOutput == .speaker
+        if case .active = state.videoState {
+            self.isVideo = true
+        } else {
+            self.isVideo = false
+        }
+
+        var connectedSince: Date?
+        let statusText: String
+        switch state.state {
+        case .waiting, .requesting:
+            statusText = "Вызов…"
+        case .ringing:
+            statusText = "Входящий звонок"
+        case .connecting:
+            statusText = "Соединение…"
+        case let .active(startTime, _, _), let .reconnecting(startTime, _, _):
+            connectedSince = Date(timeIntervalSinceReferenceDate: startTime)
+            statusText = ""
+        case .terminating, .terminated:
+            self.endActivity()
+            return
+        }
+
+        if #available(iOS 16.2, *) {
+            let content = AyoCallAttributes.ContentState(connectedSince: connectedSince, statusText: statusText, isMuted: self.isMuted, isSpeaker: self.isSpeaker, isVideo: self.isVideo)
+            if let activity = self.activity as? Activity<AyoCallAttributes> {
+                Task {
+                    await activity.update(ActivityContent(state: content, staleDate: nil))
+                }
+            } else {
+                guard ActivityAuthorizationInfo().areActivitiesEnabled else {
+                    return
+                }
+                let attributes = AyoCallAttributes(peerName: peerName, initials: ayoInitials(peerName))
+                self.activity = try? Activity<AyoCallAttributes>.request(attributes: attributes, content: ActivityContent(state: content, staleDate: nil), pushType: nil)
+            }
+        }
+    }
+
+    private func endActivity() {
+        if #available(iOS 16.2, *) {
+            if let activity = self.activity as? Activity<AyoCallAttributes> {
+                Task {
+                    await activity.end(nil, dismissalPolicy: .immediate)
+                }
+            }
+        }
+        self.activity = nil
+    }
+
+    private func perform(_ action: AyoCallAction) {
+        guard let call = self.call else {
+            return
+        }
+        switch action {
+        case .toggleMute:
+            call.toggleIsMuted()
+        case .toggleSpeaker:
+            call.setCurrentAudioOutput(self.isSpeaker ? .builtin : .speaker)
+        case .toggleVideo:
+            if self.isVideo {
+                call.disableVideo()
+            } else {
+                call.requestVideo()
+            }
+        case .hangUp:
+            let _ = call.hangUp().startStandalone()
+        }
+    }
+}
+
+private func ayoInitials(_ name: String) -> String {
+    let parts = name.split(separator: " ").prefix(2)
+    let letters = parts.compactMap { $0.first }.map { String($0) }
+    let result = letters.joined().uppercased()
+    return result.isEmpty ? "?" : result
+}
