+@available(iOS 14.0, *)
+private final class AyoColorPickerDelegate: NSObject, UIColorPickerViewControllerDelegate {
+    let completion: (UIColor) -> Void
+
+    init(completion: @escaping (UIColor) -> Void) {
+        self.completion = completion
+    }
+
+    func colorPickerViewControllerDidFinish(_ viewController: UIColorPickerViewController) {
+        self.completion(viewController.selectedColor)
+    }
+}
+
+private var ayoColorPickerDelegateKey: UInt8 = 0
+
+private func ayoRGB(_ color: UIColor) -> UInt32 {
+    var r: CGFloat = 0.0
+    var g: CGFloat = 0.0
+    var b: CGFloat = 0.0
+    var a: CGFloat = 0.0
+    color.getRed(&r, green: &g, blue: &b, alpha: &a)
+    let ri = UInt32(max(0.0, min(1.0, r)) * 255.0)
+    let gi = UInt32(max(0.0, min(1.0, g)) * 255.0)
+    let bi = UInt32(max(0.0, min(1.0, b)) * 255.0)
+    let value = (ri << 16) | (gi << 8) | bi
+    // 0 means "automatic" for text colors, keep pure black representable
+    return value == 0 ? 0x010101 : value
+}
+
+private let ayoDefaultBubbleColors: [UInt32] = [0x8A5CF6, 0x5B8CFF, 0x37C2E0, 0x3CD08A]
+
+public func ayoAppearanceController(context: AccountContext) -> ViewController {
+    let refresh = ValuePromise<Int>(0, ignoreRepeated: false)
+    var counter = 0
+    weak var currentController: ViewController?
+
+    func applyLive() {
+        let _ = updatePresentationThemeSettingsInteractively(accountManager: context.sharedContext.accountManager, { $0 }).startStandalone()
+    }
+
+    func reload() {
+        counter += 1
+        refresh.set(counter)
+        applyLive()
+    }
+
+    func pickColor(initial: UInt32?, completion: @escaping (UInt32) -> Void) {
+        guard #available(iOS 14.0, *) else {
+            return
+        }
+        guard let controller = currentController, var top = controller.view.window?.rootViewController else {
+            return
+        }
+        while let presented = top.presentedViewController {
+            top = presented
+        }
+        let picker = UIColorPickerViewController()
+        picker.supportsAlpha = false
+        if let initial {
+            picker.selectedColor = UIColor(rgb: initial)
+        }
+        let delegate = AyoColorPickerDelegate(completion: { color in
+            completion(ayoRGB(color))
+        })
+        picker.delegate = delegate
+        objc_setAssociatedObject(picker, &ayoColorPickerDelegateKey, delegate, .OBJC_ASSOCIATION_RETAIN_NONATOMIC)
+        top.present(picker, animated: true)
+    }
+
+    func setColors(_ prefix: String, _ colors: [UInt32]) {
+        if prefix == "out" {
+            AyuSettings.outgoingBubbleColors = colors
+        } else {
+            AyuSettings.incomingBubbleColors = colors
+        }
+    }
+
+    func colors(_ prefix: String) -> [UInt32] {
+        return prefix == "out" ? AyuSettings.outgoingBubbleColors : AyuSettings.incomingBubbleColors
+    }
+
+    let arguments = AyoAppearanceArguments(context: context, select: { key in
+        let parts = key.split(separator: ":", maxSplits: 1).map(String.init)
+        let name = parts[0]
+        let value = parts.count > 1 ? parts[1] : ""
+        switch name {
+        case "font":
+            AyuSettings.appFont = value
+        case "shape":
+            AyuSettings.bubbleShape = Int(value) ?? 0
+        case "outCount", "inCount":
+            let prefix = name == "outCount" ? "out" : "in"
+            let count = Int(value) ?? 0
+            var current = colors(prefix)
+            while current.count < count {
+                current.append(ayoDefaultBubbleColors[current.count])
+            }
+            if current.count > count {
+                current = Array(current.prefix(count))
+            }
+            setColors(prefix, current)
+        case "outColor", "inColor":
+            let prefix = name == "outColor" ? "out" : "in"
+            let index = Int(value) ?? 0
+            let current = colors(prefix)
+            guard index < current.count else {
+                return
+            }
+            pickColor(initial: current[index], completion: { color in
+                var updated = colors(prefix)
+                if index < updated.count {
+                    updated[index] = color
+                    setColors(prefix, updated)
+                    reload()
+                }
+            })
+            return
+        case "outText", "inText":
+            let isOutgoing = name == "outText"
+            let currentValue = isOutgoing ? AyuSettings.outgoingTextColor : AyuSettings.incomingTextColor
+            pickColor(initial: currentValue == 0 ? nil : currentValue, completion: { color in
+                if isOutgoing {
+                    AyuSettings.outgoingTextColor = color
+                } else {
+                    AyuSettings.incomingTextColor = color
+                }
+                reload()
+            })
+            return
+        case "outTextReset":
+            AyuSettings.outgoingTextColor = 0
+        case "inTextReset":
+            AyuSettings.incomingTextColor = 0
+        case "reset":
+            AyuSettings.appFont = ""
+            AyuSettings.bubbleShape = 0
+            AyuSettings.outgoingBubbleColors = []
+            AyuSettings.incomingBubbleColors = []
+            AyuSettings.outgoingTextColor = 0
+            AyuSettings.incomingTextColor = 0
+        default:
+            break
+        }
+        reload()
+    })
+
+    let signal = combineLatest(queue: .mainQueue(),
+        context.sharedContext.presentationData,
+        refresh.get()
+    )
+    |> map { presentationData, _ -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        var presentationData = presentationData
+        presentationData = presentationData.withUpdated(theme: presentationData.theme.withModalBlocksBackground())
+
+        let controllerState = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text("Оформление Ayo"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let listState = ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: ayoAppearanceEntries(), style: .blocks, animateChanges: false)
+        return (controllerState, (listState, arguments))
+    }
+
+    let controller = ItemListController(context: context, state: signal)
+    currentController = controller
+    return controller
+}
