+import Foundation
+
+/// AyuGram-style local settings. Stored in UserDefaults so they can be read
+/// synchronously from any thread (network layer, UI).
+public enum AyuSettings {
+    private static let defaults = UserDefaults.standard
+
+    private static func readFlag(_ key: String, _ def: Bool = false) -> Bool {
+        if defaults.object(forKey: key) == nil { return def }
+        return defaults.bool(forKey: key)
+    }
+    private static func writeFlag(_ key: String, _ value: Bool) {
+        defaults.set(value, forKey: key)
+    }
+
+    // Ghost mode
+    public static var dontReadMessages: Bool {
+        get { return readFlag("ayo.dontRead") }
+        set { writeFlag("ayo.dontRead", newValue) }
+    }
+    public static var dontSendTyping: Bool {
+        get { return readFlag("ayo.dontTyping") }
+        set { writeFlag("ayo.dontTyping", newValue) }
+    }
+    public static var dontSendOnline: Bool {
+        get { return readFlag("ayo.dontOnline") }
+        set { writeFlag("ayo.dontOnline", newValue) }
+    }
+    /// Master switch: turns all three on/off at once.
+    public static var ghostModeEnabled: Bool {
+        get { return dontReadMessages && dontSendTyping && dontSendOnline }
+        set {
+            dontReadMessages = newValue
+            dontSendTyping = newValue
+            dontSendOnline = newValue
+        }
+    }
+}
