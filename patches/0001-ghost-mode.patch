@@ -0,0 +1,120 @@
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import ItemListUI
+import PresentationDataUtils
+import AccountContext
+
+private final class AyoSettingsArguments {
+    let toggle: (String, Bool) -> Void
+    init(toggle: @escaping (String, Bool) -> Void) {
+        self.toggle = toggle
+    }
+}
+
+private enum AyoSettingsEntry: ItemListNodeEntry {
+    case ghostHeader
+    case ghostMaster(Bool)
+    case dontRead(Bool)
+    case dontTyping(Bool)
+    case dontOnline(Bool)
+    case ghostFooter
+
+    var section: ItemListSectionId { return 0 }
+
+    var stableId: Int32 {
+        switch self {
+        case .ghostHeader: return 0
+        case .ghostMaster: return 1
+        case .dontRead: return 2
+        case .dontTyping: return 3
+        case .dontOnline: return 4
+        case .ghostFooter: return 5
+        }
+    }
+
+    static func ==(lhs: AyoSettingsEntry, rhs: AyoSettingsEntry) -> Bool {
+        switch (lhs, rhs) {
+        case (.ghostHeader, .ghostHeader), (.ghostFooter, .ghostFooter):
+            return true
+        case let (.ghostMaster(a), .ghostMaster(b)), let (.dontRead(a), .dontRead(b)), let (.dontTyping(a), .dontTyping(b)), let (.dontOnline(a), .dontOnline(b)):
+            return a == b
+        default:
+            return false
+        }
+    }
+
+    static func <(lhs: AyoSettingsEntry, rhs: AyoSettingsEntry) -> Bool {
+        return lhs.stableId < rhs.stableId
+    }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! AyoSettingsArguments
+        switch self {
+        case .ghostHeader:
+            return ItemListSectionHeaderItem(presentationData: presentationData, text: "РЕЖИМ ПРИЗРАКА", sectionId: self.section)
+        case let .ghostMaster(value):
+            return ItemListSwitchItem(presentationData: presentationData, systemStyle: .glass, title: "Режим призрака", value: value, sectionId: self.section, style: .blocks, updated: { value in
+                arguments.toggle("master", value)
+            })
+        case let .dontRead(value):
+            return ItemListSwitchItem(presentationData: presentationData, systemStyle: .glass, title: "Не отмечать прочитанным", value: value, sectionId: self.section, style: .blocks, updated: { value in
+                arguments.toggle("read", value)
+            })
+        case let .dontTyping(value):
+            return ItemListSwitchItem(presentationData: presentationData, systemStyle: .glass, title: "Не показывать «печатает»", value: value, sectionId: self.section, style: .blocks, updated: { value in
+                arguments.toggle("typing", value)
+            })
+        case let .dontOnline(value):
+            return ItemListSwitchItem(presentationData: presentationData, systemStyle: .glass, title: "Не показывать «в сети»", value: value, sectionId: self.section, style: .blocks, updated: { value in
+                arguments.toggle("online", value)
+            })
+        case .ghostFooter:
+            return ItemListTextItem(presentationData: presentationData, text: .plain("Собеседники не увидят, что вы прочитали сообщение, печатаете или находитесь в приложении."), sectionId: self.section)
+        }
+    }
+}
+
+public func ayoSettingsController(context: AccountContext) -> ViewController {
+    let refresh = ValuePromise<Int>(0, ignoreRepeated: false)
+    var counter = 0
+
+    let arguments = AyoSettingsArguments(toggle: { key, value in
+        switch key {
+        case "master": AyuSettings.ghostModeEnabled = value
+        case "read": AyuSettings.dontReadMessages = value
+        case "typing": AyuSettings.dontSendTyping = value
+        case "online": AyuSettings.dontSendOnline = value
+        default: break
+        }
+        counter += 1
+        refresh.set(counter)
+    })
+
+    let signal = combineLatest(queue: .mainQueue(),
+        context.sharedContext.presentationData,
+        refresh.get()
+    )
+    |> map { presentationData, _ -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        var presentationData = presentationData
+        presentationData = presentationData.withUpdated(theme: presentationData.theme.withModalBlocksBackground())
+
+        let entries: [AyoSettingsEntry] = [
+            .ghostHeader,
+            .ghostMaster(AyuSettings.ghostModeEnabled),
+            .dontRead(AyuSettings.dontReadMessages),
+            .dontTyping(AyuSettings.dontSendTyping),
+            .dontOnline(AyuSettings.dontSendOnline),
+            .ghostFooter
+        ]
+
+        let controllerState = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text("Ayo настройки"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let listState = ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: entries, style: .blocks, animateChanges: false)
+        return (controllerState, (listState, arguments))
+    }
+
+    return ItemListController(context: context, state: signal)
+}
