+// Ayo: BGTaskScheduler.register() throws (crashing the app) if the identifier is not
+// listed in Info.plist. Re-signing tools may change the bundle id, so check first.
+func ayoIsBackgroundTaskPermitted(_ identifier: String) -> Bool {
+    guard let permitted = Bundle.main.object(forInfoDictionaryKey: "BGTaskSchedulerPermittedIdentifiers") as? [String] else {
+        return false
+    }
+    for item in permitted {
+        if item == identifier {
+            return true
+        }
+        if item.hasSuffix("*") && identifier.hasPrefix(String(item.dropLast())) {
+            return true
+        }
+    }
+    return false
+}
