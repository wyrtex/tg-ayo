diff --git a/submodules/TelegramCore/Sources/AyuMessageHistory.swift b/submodules/TelegramCore/Sources/AyuMessageHistory.swift
new file mode 100644
index 00000000..5c592c67
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AyuMessageHistory.swift
@@ -0,0 +1,141 @@
+import Foundation
+import Postbox
+
+/// AyuGram-style local message history: remembers which messages were deleted
+/// by the other side and the previous texts of edited messages.
+/// Stored as a JSON file in the app's Library directory, independent of Postbox.
+public final class AyuMessageHistory {
+    public struct EditEntry: Codable, Equatable {
+        public let date: Int32
+        public let text: String
+    }
+
+    private struct Storage: Codable {
+        var deleted: [String: Int32] = [:]
+        var edits: [String: [EditEntry]] = [:]
+    }
+
+    public static let shared = AyuMessageHistory()
+
+    private let lock = NSLock()
+    private var storage: Storage
+    private let path: String
+    private let saveQueue = DispatchQueue(label: "org.ayogram.message-history")
+    private var saveScheduled = false
+
+    private static let maxEditsPerMessage = 50
+
+    private init() {
+        let baseUrl = FileManager.default.urls(for: .libraryDirectory, in: .userDomainMask).first ?? URL(fileURLWithPath: NSTemporaryDirectory())
+        let directoryUrl = baseUrl.appendingPathComponent("ayo", isDirectory: true)
+        let _ = try? FileManager.default.createDirectory(at: directoryUrl, withIntermediateDirectories: true, attributes: nil)
+        self.path = directoryUrl.appendingPathComponent("message-history.json").path
+
+        if let data = try? Data(contentsOf: URL(fileURLWithPath: self.path)), let decoded = try? JSONDecoder().decode(Storage.self, from: data) {
+            self.storage = decoded
+        } else {
+            self.storage = Storage()
+        }
+    }
+
+    private static func key(_ id: MessageId) -> String {
+        return "\(id.peerId.toInt64()):\(id.namespace):\(id.id)"
+    }
+
+    public func isDeleted(_ id: MessageId) -> Bool {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return self.storage.deleted[AyuMessageHistory.key(id)] != nil
+    }
+
+    public func edits(for id: MessageId) -> [EditEntry] {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return self.storage.edits[AyuMessageHistory.key(id)] ?? []
+    }
+
+    public func markDeleted(_ ids: [MessageId], date: Int32) {
+        if ids.isEmpty {
+            return
+        }
+        self.lock.lock()
+        for id in ids {
+            self.storage.deleted[AyuMessageHistory.key(id)] = date
+        }
+        self.lock.unlock()
+        self.scheduleSave()
+    }
+
+    public func recordEdit(_ id: MessageId, previousText: String, date: Int32) {
+        let key = AyuMessageHistory.key(id)
+        self.lock.lock()
+        var entries = self.storage.edits[key] ?? []
+        if entries.last?.text != previousText {
+            entries.append(EditEntry(date: date, text: previousText))
+            if entries.count > AyuMessageHistory.maxEditsPerMessage {
+                entries.removeFirst(entries.count - AyuMessageHistory.maxEditsPerMessage)
+            }
+            self.storage.edits[key] = entries
+        }
+        self.lock.unlock()
+        self.scheduleSave()
+    }
+
+    public func clear() {
+        self.lock.lock()
+        self.storage = Storage()
+        self.lock.unlock()
+        self.scheduleSave()
+    }
+
+    private func scheduleSave() {
+        self.lock.lock()
+        if self.saveScheduled {
+            self.lock.unlock()
+            return
+        }
+        self.saveScheduled = true
+        self.lock.unlock()
+
+        self.saveQueue.asyncAfter(deadline: .now() + 1.0, execute: { [weak self] in
+            guard let self else {
+                return
+            }
+            self.lock.lock()
+            let snapshot = self.storage
+            self.saveScheduled = false
+            self.lock.unlock()
+
+            if let data = try? JSONEncoder().encode(snapshot) {
+                let _ = try? data.write(to: URL(fileURLWithPath: self.path), options: .atomic)
+            }
+        })
+    }
+}
+
+/// Keeps messages deleted by the server in Postbox and remembers them as deleted.
+/// Returns the ids that still have to be deleted for real (not present locally).
+func ayoKeepDeletedMessages(transaction: Transaction, ids: [MessageId]) -> [MessageId] {
+    var kept: [MessageId] = []
+    var remaining: [MessageId] = []
+    for id in ids {
+        // Only regular cloud messages: scheduled/quick-reply copies are removed by the server on send.
+        if id.namespace == Namespaces.Message.Cloud && transaction.getMessage(id) != nil {
+            kept.append(id)
+        } else {
+            remaining.append(id)
+        }
+    }
+    if kept.isEmpty {
+        return remaining
+    }
+    let timestamp = Int32(CFAbsoluteTimeGetCurrent() + kCFAbsoluteTimeIntervalSince1970)
+    AyuMessageHistory.shared.markDeleted(kept, date: timestamp)
+    for id in kept {
+        // Rewrite the message unchanged so chat views re-render it with the deleted mark.
+        transaction.updateMessage(id, update: { currentMessage in
+            return .update(StoreMessage(id: currentMessage.id, customStableId: nil, globallyUniqueId: currentMessage.globallyUniqueId, groupingKey: currentMessage.groupingKey, threadId: currentMessage.threadId, timestamp: currentMessage.timestamp, flags: StoreMessageFlags(currentMessage.flags), tags: currentMessage.tags, globalTags: currentMessage.globalTags, localTags: currentMessage.localTags, forwardInfo: currentMessage.forwardInfo.flatMap(StoreMessageForwardInfo.init), authorId: currentMessage.author?.id, text: currentMessage.text, attributes: currentMessage.attributes, media: currentMessage.media))
+        })
+    }
+    return remaining
+}
