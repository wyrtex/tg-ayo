+/// Only incoming messages in private chats, to avoid noise from groups and channels.
+func ayoShouldNotify(_ message: Message) -> Bool {
+    return message.flags.contains(.Incoming) && message.id.peerId.namespace == Namespaces.Peer.CloudUser
+}
+
+func ayoPreviewText(_ text: String) -> String {
+    if text.isEmpty {
+        return "[медиа]"
+    }
+    if text.count > 300 {
+        return String(text.prefix(300)) + "…"
+    }
+    return text
+}
+
+func ayoPostNotification(title: String, body: String) {
+    let content = UNMutableNotificationContent()
+    content.title = title
+    content.body = body
+    content.sound = UNNotificationSound.default
+    content.userInfo = ["ayo": true]
+    let request = UNNotificationRequest(identifier: "ayo-\(UUID().uuidString)", content: content, trigger: nil)
+    UNUserNotificationCenter.current().add(request, withCompletionHandler: nil)
+}
