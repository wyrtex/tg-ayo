+private func ayoScheduleAutoCacheCleanup(engine: TelegramEngine, accountId: AccountRecordId) {
+    let interval = AyuSettings.autoCacheCleanInterval
+    if interval == 0 {
+        return
+    }
+    let key = "ayo.lastCacheClean.\(accountId.int64)"
+    let now = Int(Date().timeIntervalSince1970)
+    let last = UserDefaults.standard.integer(forKey: key)
+    if interval > 0 && now - last < interval {
+        return
+    }
+    Queue.mainQueue().after(15.0, {
+        UserDefaults.standard.set(now, forKey: key)
+        // Stickers and avatars are kept so the UI does not flicker while they reload.
+        let _ = engine.resources.clearStorage(peerId: nil, categories: [.photos, .videos, .files, .music, .misc, .stories], includeMessages: [], excludeMessages: []).startStandalone()
+    })
+}
