+                HStack(spacing: 12) {
+                    AyoCallAvatar(initials: context.attributes.initials, size: 44)
+                    VStack(alignment: .leading, spacing: 2) {
+                        Text(context.attributes.peerName)
+                            .font(.headline)
+                            .lineLimit(1)
+                        AyoCallTimerText(state: context.state)
+                            .font(.subheadline)
+                            .foregroundColor(.secondary)
+                    }
+                    Spacer()
+                }
+                AyoCallButtons(state: context.state)
