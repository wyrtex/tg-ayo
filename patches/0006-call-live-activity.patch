@@ -0,0 +1,115 @@
+import Foundation
+#if canImport(ActivityKit)
+import ActivityKit
+#endif
+#if canImport(AppIntents)
+import AppIntents
+#endif
+
+/// Ayo: Live Activity (Dynamic Island / lock screen) for 1-on-1 calls.
+/// Shared between the main app (starts/updates the activity, performs actions)
+/// and the widget extension (renders it).
+
+public enum AyoCallAction: String {
+    case toggleMute
+    case toggleSpeaker
+    case toggleVideo
+    case hangUp
+}
+
+/// Set by the main app; intents call it when a button in the Dynamic Island is pressed.
+public enum AyoCallActionHandler {
+    public static var handler: ((AyoCallAction) -> Void)?
+}
+
+#if canImport(ActivityKit)
+@available(iOS 16.1, *)
+public struct AyoCallAttributes: ActivityAttributes {
+    public struct ContentState: Codable, Hashable, Sendable {
+        /// nil while the call is not connected yet
+        public var connectedSince: Date?
+        public var statusText: String
+        public var isMuted: Bool
+        public var isSpeaker: Bool
+        public var isVideo: Bool
+
+        public init(connectedSince: Date?, statusText: String, isMuted: Bool, isSpeaker: Bool, isVideo: Bool) {
+            self.connectedSince = connectedSince
+            self.statusText = statusText
+            self.isMuted = isMuted
+            self.isSpeaker = isSpeaker
+            self.isVideo = isVideo
+        }
+    }
+
+    public var peerName: String
+    public var initials: String
+
+    public init(peerName: String, initials: String) {
+        self.peerName = peerName
+        self.initials = initials
+    }
+}
+#endif
+
+#if canImport(AppIntents)
+@available(iOS 17.0, *)
+public struct AyoCallToggleMuteIntent: LiveActivityIntent {
+    public static var title: LocalizedStringResource = "Микрофон"
+
+    public init() {
+    }
+
+    public func perform() async throws -> some IntentResult {
+        await MainActor.run {
+            AyoCallActionHandler.handler?(.toggleMute)
+        }
+        return .result()
+    }
+}
+
+@available(iOS 17.0, *)
+public struct AyoCallToggleSpeakerIntent: LiveActivityIntent {
+    public static var title: LocalizedStringResource = "Динамик"
+
+    public init() {
+    }
+
+    public func perform() async throws -> some IntentResult {
+        await MainActor.run {
+            AyoCallActionHandler.handler?(.toggleSpeaker)
+        }
+        return .result()
+    }
+}
+
+@available(iOS 17.0, *)
+public struct AyoCallToggleVideoIntent: LiveActivityIntent {
+    public static var title: LocalizedStringResource = "Камера"
+
+    public init() {
+    }
+
+    public func perform() async throws -> some IntentResult {
+        await MainActor.run {
+            AyoCallActionHandler.handler?(.toggleVideo)
+        }
+        return .result()
+    }
+}
+
+@available(iOS 17.0, *)
+public struct AyoCallHangUpIntent: LiveActivityIntent {
+    public static var title: LocalizedStringResource = "Завершить"
+
+    public init() {
+    }
+
+    public func perform() async throws -> some IntentResult {
+        await MainActor.run {
+            AyoCallActionHandler.handler?(.hangUp)
+        }
+        return .result()
+    }
+}
+#endif
