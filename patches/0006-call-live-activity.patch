+#if arch(arm64) || arch(x86_64)
+#if canImport(ActivityKit)
+
+import SwiftUI
+import WidgetKit
+import ActivityKit
+#if canImport(AppIntents)
+import AppIntents
+#endif
+import AyoCallActivity
+
+private let ayoAccent = Color(red: 0.62, green: 0.42, blue: 1.0)
+
+@available(iOS 16.1, *)
+private struct AyoCallTimerText: View {
+    let state: AyoCallAttributes.ContentState
+
+    var body: some View {
+        if let connectedSince = state.connectedSince {
+            Text(timerInterval: connectedSince ... Date.distantFuture, countsDown: false)
+                .monospacedDigit()
+        } else {
+            Text(state.statusText)
+        }
+    }
+}
+
+@available(iOS 16.1, *)
+private struct AyoCallAvatar: View {
+    let initials: String
+    let size: CGFloat
+
+    var body: some View {
+        ZStack {
+            Circle().fill(ayoAccent)
+            Text(initials)
+                .font(.system(size: size * 0.4, weight: .semibold))
+                .foregroundColor(.white)
+        }
+        .frame(width: size, height: size)
+    }
+}
+
+@available(iOS 16.1, *)
+private struct AyoCallButtons: View {
+    let state: AyoCallAttributes.ContentState
+
+    var body: some View {
+        if #available(iOS 17.0, *) {
+            HStack(spacing: 14) {
+                Button(intent: AyoCallToggleMuteIntent()) {
+                    AyoCallButtonLabel(systemName: state.isMuted ? "mic.slash.fill" : "mic.fill", isActive: state.isMuted, isDestructive: false)
+                }
+                .buttonStyle(.plain)
+                Button(intent: AyoCallToggleSpeakerIntent()) {
+                    AyoCallButtonLabel(systemName: state.isSpeaker ? "speaker.wave.3.fill" : "speaker.fill", isActive: state.isSpeaker, isDestructive: false)
+                }
+                .buttonStyle(.plain)
+                Button(intent: AyoCallToggleVideoIntent()) {
+                    AyoCallButtonLabel(systemName: state.isVideo ? "video.fill" : "video.slash.fill", isActive: state.isVideo, isDestructive: false)
+                }
+                .buttonStyle(.plain)
+                Button(intent: AyoCallHangUpIntent()) {
+                    AyoCallButtonLabel(systemName: "phone.down.fill", isActive: false, isDestructive: true)
+                }
+                .buttonStyle(.plain)
+            }
+        } else {
+            Text("Нажмите, чтобы открыть звонок")
+                .font(.footnote)
+                .foregroundColor(.secondary)
+        }
+    }
+}
+
+@available(iOS 16.1, *)
+private struct AyoCallButtonLabel: View {
+    let systemName: String
+    let isActive: Bool
+    let isDestructive: Bool
+
+    var body: some View {
+        ZStack {
+            Circle().fill(isDestructive ? Color.red : (isActive ? Color.white : Color.white.opacity(0.18)))
+            Image(systemName: systemName)
+                .font(.system(size: 18, weight: .semibold))
+                .foregroundColor(isActive && !isDestructive ? .black : .white)
+        }
+        .frame(width: 48, height: 48)
+    }
+}
+
+@available(iOS 16.1, *)
+struct AyoCallLiveActivityWidget: Widget {
+    var body: some WidgetConfiguration {
+        ActivityConfiguration(for: AyoCallAttributes.self) { context in
