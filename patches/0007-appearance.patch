@@ -0,0 +1,56 @@
+import Foundation
+import UIKit
+import Display
+import TelegramCore
+
+/// Ayo: user overrides for message bubble and text colors (Ayo settings → Оформление).
+func ayoApplyAppearance(_ theme: PresentationTheme) -> PresentationTheme {
+    let outgoingColors = AyuSettings.outgoingBubbleColors
+    let incomingColors = AyuSettings.incomingBubbleColors
+    let outgoingTextColor = AyuSettings.outgoingTextColor
+    let incomingTextColor = AyuSettings.incomingTextColor
+    if outgoingColors.isEmpty && incomingColors.isEmpty && outgoingTextColor == 0 && incomingTextColor == 0 {
+        return theme
+    }
+
+    let message = theme.chat.message.withUpdated(
+        incoming: ayoApplyBubbleColors(theme.chat.message.incoming, colors: incomingColors, textColor: incomingTextColor),
+        outgoing: ayoApplyBubbleColors(theme.chat.message.outgoing, colors: outgoingColors, textColor: outgoingTextColor)
+    )
+    return PresentationTheme(name: theme.name, index: theme.index, referenceTheme: theme.referenceTheme, overallDarkAppearance: theme.overallDarkAppearance, intro: theme.intro, passcode: theme.passcode, rootController: theme.rootController, list: theme.list, chatList: theme.chatList, chat: theme.chat.withUpdated(message: message), actionSheet: theme.actionSheet, contextMenu: theme.contextMenu, inAppNotification: theme.inAppNotification, chart: theme.chart, preview: theme.preview)
+}
+
+private func ayoApplyBubbleColors(_ parted: PresentationThemePartedColors, colors: [UInt32], textColor: UInt32) -> PresentationThemePartedColors {
+    var result = parted
+    if !colors.isEmpty {
+        let fill = colors.map { UIColor(rgb: $0) }
+        let highlightedFill = fill[0].withMultipliedBrightnessBy(0.85)
+        let withWallpaper = parted.bubble.withWallpaper.withUpdated(fill: fill, highlightedFill: highlightedFill, stroke: .clear)
+        let withoutWallpaper = parted.bubble.withoutWallpaper.withUpdated(fill: fill, highlightedFill: highlightedFill, stroke: .clear)
+        result = result.withUpdated(bubble: parted.bubble.withUpdated(withWallpaper: withWallpaper, withoutWallpaper: withoutWallpaper))
+    }
+
+    var primaryTextColor: UIColor?
+    if textColor != 0 {
+        primaryTextColor = UIColor(rgb: textColor)
+    } else if !colors.isEmpty {
+        primaryTextColor = ayoContrastingTextColor(colors)
+    }
+    if let primaryTextColor {
+        let secondaryTextColor = primaryTextColor.withAlphaComponent(0.6)
+        result = result.withUpdated(primaryTextColor: primaryTextColor, secondaryTextColor: secondaryTextColor, fileTitleColor: primaryTextColor, fileDescriptionColor: secondaryTextColor, fileDurationColor: secondaryTextColor)
+    }
+    return result
+}
+
+private func ayoContrastingTextColor(_ colors: [UInt32]) -> UIColor {
+    var luminance: CGFloat = 0.0
+    for color in colors {
+        let r = CGFloat((color >> 16) & 0xff) / 255.0
+        let g = CGFloat((color >> 8) & 0xff) / 255.0
+        let b = CGFloat(color & 0xff) / 255.0
+        luminance += 0.299 * r + 0.587 * g + 0.114 * b
+    }
+    luminance /= CGFloat(colors.count)
+    return luminance > 0.62 ? UIColor.black : UIColor.white
+}
