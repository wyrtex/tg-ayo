+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import ItemListUI
+import PresentationDataUtils
+import AccountContext
+
+private final class AyoAppearanceArguments {
+    let select: (String) -> Void
+    init(select: @escaping (String) -> Void) {
+        self.select = select
+    }
+}
+
+private enum AyoAppearanceEntry: ItemListNodeEntry {
+    case header(id: Int32, section: Int32, text: String)
+    case option(id: Int32, section: Int32, key: String, title: String, checked: Bool)
+    case color(id: Int32, section: Int32, key: String, title: String, color: UInt32?)
+    case action(id: Int32, section: Int32, key: String, title: String, destructive: Bool)
+    case footer(id: Int32, section: Int32, text: String)
+
+    var section: ItemListSectionId {
+        switch self {
+        case let .header(_, section, _), let .option(_, section, _, _, _), let .color(_, section, _, _, _), let .action(_, section, _, _, _), let .footer(_, section, _):
+            return section
+        }
+    }
+
+    var stableId: Int32 {
+        switch self {
+        case let .header(id, _, _), let .option(id, _, _, _, _), let .color(id, _, _, _, _), let .action(id, _, _, _, _), let .footer(id, _, _):
+            return id
+        }
+    }
+
+    static func ==(lhs: AyoAppearanceEntry, rhs: AyoAppearanceEntry) -> Bool {
+        switch (lhs, rhs) {
+        case let (.header(lId, lSection, lText), .header(rId, rSection, rText)):
+            return lId == rId && lSection == rSection && lText == rText
+        case let (.option(lId, lSection, lKey, lTitle, lChecked), .option(rId, rSection, rKey, rTitle, rChecked)):
+            return lId == rId && lSection == rSection && lKey == rKey && lTitle == rTitle && lChecked == rChecked
+        case let (.color(lId, lSection, lKey, lTitle, lColor), .color(rId, rSection, rKey, rTitle, rColor)):
+            return lId == rId && lSection == rSection && lKey == rKey && lTitle == rTitle && lColor == rColor
+        case let (.action(lId, lSection, lKey, lTitle, lDestructive), .action(rId, rSection, rKey, rTitle, rDestructive)):
+            return lId == rId && lSection == rSection && lKey == rKey && lTitle == rTitle && lDestructive == rDestructive
+        case let (.footer(lId, lSection, lText), .footer(rId, rSection, rText)):
+            return lId == rId && lSection == rSection && lText == rText
+        default:
+            return false
+        }
+    }
+
+    static func <(lhs: AyoAppearanceEntry, rhs: AyoAppearanceEntry) -> Bool {
+        return lhs.stableId < rhs.stableId
+    }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! AyoAppearanceArguments
+        switch self {
+        case let .header(_, section, text):
+            return ItemListSectionHeaderItem(presentationData: presentationData, text: text, sectionId: section)
+        case let .option(_, section, key, title, checked):
+            return ItemListCheckboxItem(presentationData: presentationData, systemStyle: .glass, title: title, style: .left, checked: checked, zeroSeparatorInsets: false, sectionId: section, action: {
+                arguments.select(key)
+            })
+        case let .color(_, section, key, title, color):
+            let icon = generateFilledCircleImage(diameter: 22.0, color: color.flatMap { UIColor(rgb: $0) } ?? UIColor.clear, strokeColor: UIColor(white: 0.5, alpha: 0.5), strokeWidth: 1.0)
+            return ItemListDisclosureItem(presentationData: presentationData, systemStyle: .glass, icon: icon, title: title, label: color.flatMap { ayoHexString($0) } ?? "Авто", labelStyle: .text, sectionId: section, style: .blocks, disclosureStyle: .arrow, action: {
+                arguments.select(key)
+            })
+        case let .action(_, section, key, title, destructive):
+            return ItemListActionItem(presentationData: presentationData, systemStyle: .glass, title: title, kind: destructive ? .destructive : .generic, alignment: .natural, sectionId: section, style: .blocks, action: {
+                arguments.select(key)
+            })
+        case let .footer(_, section, text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: section)
+        }
+    }
+}
+
+private func ayoHexString(_ color: UInt32) -> String {
+    return String(format: "#%06X", color & 0xffffff)
+}
+
+private let ayoFontOptions: [(String, String)] = [
+    ("", "Системный"),
+    ("rounded", "Скруглённый (SF Rounded)"),
+    ("serif", "С засечками (New York)"),
+    ("mono", "Моноширинный (SF Mono)"),
+    ("Avenir Next", "Avenir Next"),
+    ("Helvetica Neue", "Helvetica Neue"),
+    ("Futura", "Futura"),
+    ("Gill Sans", "Gill Sans"),
+    ("Georgia", "Georgia"),
+    ("Baskerville", "Baskerville"),
+    ("Didot", "Didot"),
+    ("Courier New", "Courier New"),
+    ("Noteworthy", "Noteworthy"),
+    ("Chalkboard SE", "Chalkboard SE"),
+    ("Marker Felt", "Marker Felt"),
+]
+
+private let ayoShapeOptions: [(Int, String)] = [
+    (0, "Обычная, с хвостиком"),
+    (1, "Без хвостика"),
+    (2, "Одинаковые углы"),
+    (3, "Прямоугольная"),
+]
+
+private let ayoColorCountTitles: [String] = [
+    "Как в теме",
+    "1 цвет",
+    "2 цвета (градиент)",
+    "3 цвета (градиент)",
+    "4 цвета (градиент)",
+]
+
+private func ayoAppearanceEntries() -> [AyoAppearanceEntry] {
+    var entries: [AyoAppearanceEntry] = []
+
+    entries.append(.header(id: 0, section: 0, text: "ШРИФТ ПРИЛОЖЕНИЯ"))
+    let currentFont = AyuSettings.appFont
+    for (index, option) in ayoFontOptions.enumerated() {
+        entries.append(.option(id: Int32(1 + index), section: 0, key: "font:\(option.0)", title: option.1, checked: currentFont == option.0))
+    }
+
+    entries.append(.header(id: 100, section: 1, text: "ФОРМА СООБЩЕНИЙ"))
+    let currentShape = AyuSettings.bubbleShape
+    for (index, option) in ayoShapeOptions.enumerated() {
+        entries.append(.option(id: Int32(101 + index), section: 1, key: "shape:\(option.0)", title: option.1, checked: currentShape == option.0))
+    }
+    entries.append(.footer(id: 120, section: 1, text: "Радиус углов настраивается в «Оформление» → «Углы блоков с сообщениями»."))
+
+    func appendBubbleSection(baseId: Int32, section: Int32, title: String, prefix: String, colors: [UInt32], textColor: UInt32) {
+        entries.append(.header(id: baseId, section: section, text: title))
+        for count in 0 ... 4 {
+            entries.append(.option(id: baseId + 1 + Int32(count), section: section, key: "\(prefix)Count:\(count)", title: ayoColorCountTitles[count], checked: colors.count == count))
+        }
+        for index in 0 ..< colors.count {
+            entries.append(.color(id: baseId + 10 + Int32(index), section: section, key: "\(prefix)Color:\(index)", title: "Цвет \(index + 1)", color: colors[index]))
+        }
+        entries.append(.color(id: baseId + 20, section: section, key: "\(prefix)Text", title: "Цвет текста", color: textColor == 0 ? nil : textColor))
+        if textColor != 0 {
+            entries.append(.action(id: baseId + 21, section: section, key: "\(prefix)TextReset", title: "Цвет текста: автоматически", destructive: false))
+        }
+    }
+    appendBubbleSection(baseId: 200, section: 2, title: "МОИ СООБЩЕНИЯ", prefix: "out", colors: AyuSettings.outgoingBubbleColors, textColor: AyuSettings.outgoingTextColor)
+    appendBubbleSection(baseId: 300, section: 3, title: "СООБЩЕНИЯ СОБЕСЕДНИКОВ", prefix: "in", colors: AyuSettings.incomingBubbleColors, textColor: AyuSettings.incomingTextColor)
+
+    entries.append(.action(id: 400, section: 4, key: "reset", title: "Сбросить оформление Ayo", destructive: true))
+    entries.append(.footer(id: 401, section: 4, text: "Изменения применяются после перезапуска AyoGram: смахните приложение в переключателе и откройте снова. Автоматический цвет текста подбирается под яркость пузыря."))
+
+    return entries
+}
+
+@available(iOS 14.0, *)
+private final class AyoColorPickerDelegate: NSObject, UIColorPickerViewControllerDelegate {
+    let completion: (UIColor) -> Void
+
+    init(completion: @escaping (UIColor) -> Void) {
+        self.completion = completion
+    }
+
+    func colorPickerViewControllerDidFinish(_ viewController: UIColorPickerViewController) {
+        self.completion(viewController.selectedColor)
+    }
+}
+
+private var ayoColorPickerDelegateKey: UInt8 = 0
+
+private func ayoRGB(_ color: UIColor) -> UInt32 {
+    var r: CGFloat = 0.0
+    var g: CGFloat = 0.0
+    var b: CGFloat = 0.0
+    var a: CGFloat = 0.0
+    color.getRed(&r, green: &g, blue: &b, alpha: &a)
+    let ri = UInt32(max(0.0, min(1.0, r)) * 255.0)
+    let gi = UInt32(max(0.0, min(1.0, g)) * 255.0)
+    let bi = UInt32(max(0.0, min(1.0, b)) * 255.0)
+    let value = (ri << 16) | (gi << 8) | bi
+    // 0 means "automatic" for text colors, keep pure black representable
+    return value == 0 ? 0x010101 : value
+}
+
+private let ayoDefaultBubbleColors: [UInt32] = [0x8A5CF6, 0x5B8CFF, 0x37C2E0, 0x3CD08A]
+
+public func ayoAppearanceController(context: AccountContext) -> ViewController {
+    let refresh = ValuePromise<Int>(0, ignoreRepeated: false)
+    var counter = 0
+    weak var currentController: ViewController?
+
+    func reload() {
+        counter += 1
+        refresh.set(counter)
+    }
+
+    func pickColor(initial: UInt32?, completion: @escaping (UInt32) -> Void) {
+        guard #available(iOS 14.0, *) else {
+            return
+        }
+        guard let controller = currentController, var top = controller.view.window?.rootViewController else {
+            return
+        }
+        while let presented = top.presentedViewController {
+            top = presented
+        }
+        let picker = UIColorPickerViewController()
+        picker.supportsAlpha = false
+        if let initial {
+            picker.selectedColor = UIColor(rgb: initial)
+        }
+        let delegate = AyoColorPickerDelegate(completion: { color in
+            completion(ayoRGB(color))
+        })
+        picker.delegate = delegate
+        objc_setAssociatedObject(picker, &ayoColorPickerDelegateKey, delegate, .OBJC_ASSOCIATION_RETAIN_NONATOMIC)
+        top.present(picker, animated: true)
+    }
+
+    func setColors(_ prefix: String, _ colors: [UInt32]) {
+        if prefix == "out" {
+            AyuSettings.outgoingBubbleColors = colors
+        } else {
+            AyuSettings.incomingBubbleColors = colors
+        }
+    }
+
+    func colors(_ prefix: String) -> [UInt32] {
+        return prefix == "out" ? AyuSettings.outgoingBubbleColors : AyuSettings.incomingBubbleColors
+    }
+
+    let arguments = AyoAppearanceArguments(select: { key in
+        let parts = key.split(separator: ":", maxSplits: 1).map(String.init)
+        let name = parts[0]
+        let value = parts.count > 1 ? parts[1] : ""
+        switch name {
+        case "font":
+            AyuSettings.appFont = value
+        case "shape":
+            AyuSettings.bubbleShape = Int(value) ?? 0
+        case "outCount", "inCount":
+            let prefix = name == "outCount" ? "out" : "in"
+            let count = Int(value) ?? 0
+            var current = colors(prefix)
+            while current.count < count {
+                current.append(ayoDefaultBubbleColors[current.count])
+            }
+            if current.count > count {
+                current = Array(current.prefix(count))
+            }
+            setColors(prefix, current)
+        case "outColor", "inColor":
+            let prefix = name == "outColor" ? "out" : "in"
+            let index = Int(value) ?? 0
+            let current = colors(prefix)
+            guard index < current.count else {
+                return
+            }
+            pickColor(initial: current[index], completion: { color in
+                var updated = colors(prefix)
+                if index < updated.count {
+                    updated[index] = color
+                    setColors(prefix, updated)
+                    reload()
+                }
+            })
+            return
+        case "outText", "inText":
+            let isOutgoing = name == "outText"
+            let currentValue = isOutgoing ? AyuSettings.outgoingTextColor : AyuSettings.incomingTextColor
+            pickColor(initial: currentValue == 0 ? nil : currentValue, completion: { color in
+                if isOutgoing {
+                    AyuSettings.outgoingTextColor = color
+                } else {
+                    AyuSettings.incomingTextColor = color
+                }
+                reload()
+            })
+            return
+        case "outTextReset":
+            AyuSettings.outgoingTextColor = 0
+        case "inTextReset":
+            AyuSettings.incomingTextColor = 0
+        case "reset":
+            AyuSettings.appFont = ""
+            AyuSettings.bubbleShape = 0
+            AyuSettings.outgoingBubbleColors = []
+            AyuSettings.incomingBubbleColors = []
+            AyuSettings.outgoingTextColor = 0
+            AyuSettings.incomingTextColor = 0
+        default:
+            break
+        }
+        reload()
+    })
+
+    let signal = combineLatest(queue: .mainQueue(),
+        context.sharedContext.presentationData,
+        refresh.get()
+    )
+    |> map { presentationData, _ -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        var presentationData = presentationData
+        presentationData = presentationData.withUpdated(theme: presentationData.theme.withModalBlocksBackground())
+
+        let controllerState = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text("Оформление Ayo"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let listState = ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: ayoAppearanceEntries(), style: .blocks, animateChanges: false)
+        return (controllerState, (listState, arguments))
+    }
+
+    let controller = ItemListController(context: context, state: signal)
+    currentController = controller
+    return controller
+}
