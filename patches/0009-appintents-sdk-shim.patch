+++ b/submodules/AyoCallActivity/Shim/AyoAppIntentsShim.m
@@ -0,0 +1,11 @@
+#import <Foundation/Foundation.h>
+
+// Ayo: empty objc_library so the AppIntents SDK framework can be declared as a
+// (weak) dependency. rules_apple's app_intents_aspect requires the swift_library
+// passed as `app_intents` to depend on the AppIntents SDK framework; swift_library
+// has no sdk_frameworks attribute, so this shim carries it.
+@interface AyoAppIntentsShim : NSObject
+@end
+
+@implementation AyoAppIntentsShim
+@end
